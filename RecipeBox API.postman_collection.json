
{
  "info": {
    "name": "RecipeBox API",
    "description": "Pengujian RESTful API Laravel RecipeBox menggunakan Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Menguji Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@recipebox.com\",\"password\":\"{{admin_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/login"
      }
    },
    {
      "name": "Menguji Akses Tanpa Token",
      "request": {
        "auth": {
