          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/me"
      }
    },
    {
      "name": "Menguji Akses Menggunakan Token",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/me"
